# Copie para .env e ajuste. Todas as variáveis são opcionais no desenvolvimento.

# development | production | desktop
ENVIRONMENT=development
# SQLite local (padrão) ou PostgreSQL: postgresql://usuario:senha@localhost:5432/estoque
DATABASE_URL=sqlite:///./data/estoque.db
# Obrigatória em produção (gere com: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=
# Fuso usado em relatórios e na previsão
TIMEZONE=America/Sao_Paulo

# Serve o React compilado pela própria API (produção / executável)
FRONTEND_DIST=../frontend/dist

# Popula dados de exemplo e mostra as contas demo na tela de login
DEMO_MODE=false

# Cria o primeiro administrador automaticamente (senão aparece a tela de configuração inicial)
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# Assistente com IA (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# Alertas por e-mail (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Alertas pelo Telegram (crie um bot com o @BotFather)
TELEGRAM_BOT_TOKEN=

# Token dos gatilhos externos /api/v1/internal/* (cron)
CRON_TOKEN=
